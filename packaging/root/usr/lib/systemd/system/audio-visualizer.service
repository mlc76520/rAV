[Unit]
Description=OLED Audio Visualizer (rav-audio)
After=network.target sound.target mpd.service

[Service]
Type=simple
# Same user as MPD and its PipeWire instance; the panels and buttons only
# need the gpio and spi groups (gpiochip/spidev), not root.
User=mpd
Group=audio
SupplementaryGroups=gpio spi
ExecStart=/usr/bin/rav-visualizer
# Fonts are looked up relative to the working directory
WorkingDirectory=/usr/share/rav-audio
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not yes: "yes" also hides /run/user, where PipeWire's socket is
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
