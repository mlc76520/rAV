#!/bin/sh
# rav-audio postinst: uid-dependent systemd drop-ins, PipeWire linger for
# mpd, Bluetooth settings, then (re)start the stack
set -e

STATE=/var/lib/rav-audio
GEN=50-rav-audio-runtime.conf
UNITS="audio-visualizer.service bt-agent.service bt-discoverable.service"

write_dropin() { # file, then content on stdin
    mkdir -p "$(dirname "$1")"
    cat > "$1"
}

# "Key = value" in bluez main.conf, uncommenting the default line; returns 0
# only when the file changed
set_bt_key() {
    f=/etc/bluetooth/main.conf
    [ -f "$f" ] || return 1
    grep -Eq "^$1 *= *$2\$" "$f" && return 1
    if grep -Eq "^#? *$1 *=" "$f"; then
        sed -i -E "0,/^#? *$1 *=.*/s//$1 = $2/" "$f"
    else
        printf '%s = %s\n' "$1" "$2" >> "$f"
    fi
    return 0
}

warn() { echo "rav-audio: WARNING: $*" >&2; }

case "$1" in
configure)
    mkdir -p "$STATE"
    uid=$(id -u mpd)
    echo "$uid" > "$STATE/mpd-uid"

    write_dropin /etc/systemd/system/mpd.service.d/$GEN <<EOT
# Generated by rav-audio postinst (mpd uid $uid), removed with the package.
# MPD drops to user mpd, whose PipeWire runs in its lingering user manager.
[Unit]
Wants=user@$uid.service
After=user@$uid.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/$uid
EOT
    write_dropin /etc/systemd/system/audio-visualizer.service.d/$GEN <<EOT
# Generated by rav-audio postinst (mpd uid $uid), removed with the package.
# Capture from the PipeWire instance of user mpd.
[Unit]
Wants=user@$uid.service
After=user@$uid.service

[Service]
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/$uid
EOT
    write_dropin /etc/systemd/system/user@$uid.service.d/$GEN <<EOT
# Generated by rav-audio postinst, removed with the package.
# Let PipeWire (user mpd) take realtime priority itself; no rtkit needed.
[Service]
LimitRTPRIO=95
LimitNICE=-19
LimitMEMLOCK=infinity
EOT

    # bluealsa would compete with PipeWire for the A2DP endpoints
    for s in bluealsa-aplay.service bluealsa.service; do
        if systemctl is-enabled --quiet "$s" 2>/dev/null; then
            systemctl disable --now "$s" || true
            touch "$STATE/$s.was-enabled"
        fi
    done

    bt_changed=
    set_bt_key Class 0x240414 && bt_changed=1
    set_bt_key DiscoverableTimeout 0 && bt_changed=1
    set_bt_key AlwaysPairable true && bt_changed=1
    set_bt_key PairableTimeout 0 && bt_changed=1
    set_bt_key AutoEnable true && bt_changed=1

    # The PIN is never shipped: keep the existing one, or generate one
    if [ ! -f /etc/bluetooth/pin.conf ]; then
        ( umask 077; printf '* %04d\n' "$(shuf -i 0-9999 -n 1)" > /etc/bluetooth/pin.conf )
        echo "rav-audio: generated Bluetooth PIN in /etc/bluetooth/pin.conf"
    fi

    # Any output works (I2S DAC preferred, else the onboard jack): only
    # check that one is enabled, and SPI for the OLEDs
    cfg=/boot/firmware/config.txt; [ -f "$cfg" ] || cfg=/boot/config.txt
    if grep -q '^dtoverlay=hifiberry' "$cfg" 2>/dev/null; then
        echo "rav-audio: audio output: HifiBerry ($cfg)"
    elif grep -q '^dtparam=audio=on' "$cfg" 2>/dev/null; then
        echo "rav-audio: audio output: onboard (no HifiBerry overlay in $cfg)"
    else
        warn "no audio output enabled in $cfg (dtoverlay=hifiberry-... or dtparam=audio=on)"
    fi
    grep -q '^dtparam=spi=on' "$cfg" 2>/dev/null || warn "dtparam=spi=on missing from $cfg (OLED displays)"
    for u in $UNITS; do
        if [ -e "/etc/systemd/system/$u" ]; then
            warn "/etc/systemd/system/$u overrides the packaged unit"
        fi
    done

    if [ -d /run/systemd/system ]; then
        loginctl enable-linger mpd || warn "could not enable linger for mpd"
        systemctl daemon-reload
        systemctl enable $UNITS
        # Apply PipeWire/WirePlumber and realtime changes to mpd's session
        systemctl restart "user@$uid.service" || true
        if [ -n "$bt_changed" ]; then systemctl restart bluetooth.service || true; fi
        systemctl restart mpd.service bt-agent.service || true
        systemctl start bt-discoverable.service || true
        systemctl restart audio-visualizer.service || true
    fi
    ;;
esac

exit 0
